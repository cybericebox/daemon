{
  "devices": [
    {
      "image": "registry.example/frr:10",
      "name": "r1",
      "service": {
        "args": [
          "/usr/lib/frr/docker-start"
        ],
        "command": [
          "/sbin/tini",
          "--"
        ],
        "user": "frr",
        "workingDir": "/var/run/frr"
      },
      "terminal": {
        "command": [
          "/bin/bash"
        ],
        "enabled": true,
        "user": "root"
      },
      "type": "container"
    },
    {
      "image": "registry.example/web:1",
      "name": "srv",
      "service": {
        "args": [
          "--port",
          "80"
        ],
        "command": [
          "/app/serve"
        ],
        "user": "www-data"
      },
      "type": "container"
    }
  ],
  "internet": {},
  "vpn": {}
}
